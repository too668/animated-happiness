# YOO 图片托管 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ── 管理后台密码 ──
ADMIN_PASSWORD=your_admin_password_here

# ── API Keys 存储 (Upstash Redis) ──
UPSTASH_REDIS_REST_URL=https://your-upstash-db.redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── iDrive e2 S3 存储 ──
# 仅在需要使用 S3 时配置
IDRIVE_BUCKET=your-idrive-bucket-name
IDRIVE_ACCESS_KEY_ID=your_idrive_access_key
IDRIVE_SECRET_ACCESS_KEY=your_idrive_secret_key
