# YOO 图片托管 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ── 管理后台密码 ──
ADMIN_PASSWORD=your_admin_password_here

# ── 元数据数据库 (Supabase) ──
# API keys / 文件夹 / 图册 都存这里（与图片桶隔离，记录只存 sha256 哈希）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_service_role_key_here

# ── S3 兼容对象存储 (Backblaze B2 / Cloudflare R2 / AWS S3) ──
# 预置支持 Backblaze B2（永久免费 10GB，兼容 S3 协议）
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=yoo-bucket
S3_ACCESS_KEY_ID=your_key_id
S3_SECRET_ACCESS_KEY=your_application_key
# 兼容旧版变量名：
# IDRIVE_BUCKET=your_bucket
# IDRIVE_ACCESS_KEY_ID=your_key
# IDRIVE_SECRET_ACCESS_KEY=your_secret
